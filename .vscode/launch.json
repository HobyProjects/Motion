{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(Windows) Launch Motion Engine - Debug",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug-x64/MotionEngine.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "externalTerminal",
            "preLaunchTask": "CMake: build",
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            "name": "(Windows) Launch Motion Engine - Release",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Release-x64/MotionEngine.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "externalTerminal",
            "preLaunchTask": "CMake: build",
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            "name": "(Windows) Attach to Process",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}